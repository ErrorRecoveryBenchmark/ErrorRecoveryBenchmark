  "name": "RecoverBench",
  "description": "RecoverBench: 1,360 evaluation scenes, 5,038 training scenes and 10,598 recovery trajectories (973 human, 668 generated, 8,957 augmented). A separate 739-trajectory HDF5 artifact supports recovery-policy training. Image observations are stored in demonstration NPZ files with alignment and rendering provenance where available. Structural validation does not certify action replay.",
  "url": "https://huggingface.co/datasets/ErrorRecovery/ErrorRecoveryBenchmark",
  "license": "https://opensource.org/licenses/MIT",
  "version": "1.1.1",
  "keywords": [
    "robotics",
    "manipulation",
    "error recovery",
    "benchmark",
    "imitation learning",
    "MuJoCo",
    "robosuite",
    "teleoperation"
  ],
